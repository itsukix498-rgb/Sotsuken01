# このファイルをコピーして .env という名前にし、値を入れてください。
# .env は .gitignore で除外しているので GitHub には上がりません。キーはチャットなどに貼らないでください。

# Semantic Scholar の APIキー（https://www.semanticscholar.org/product/api#api-key-form で申請）
SEMANTIC_SCHOLAR_API_KEY=

# Gemini API のキー（Google AI Studio https://aistudio.google.com/ で作成）
GEMINI_API_KEY=

# Ollama（自分のPCで動くLLM）の場所。ふつうは変更不要
OLLAMA_URL=http://localhost:11434
